# ============================================================================
# Smart Travel Planner API - example environment
# Copy to `backend/.env` and replace every `<...>` placeholder.
# NEVER commit the real .env file or place credentials in client code.
# Neon values come from `neon env pull` (writes .env.local at the repo root);
# copy the NEON_* / AWS_* / DATABASE_URL lines you need into backend/.env.
# ============================================================================

# --------------------------------------------------------------------- app
APP_NAME=Smart Travel Planner API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Comma-separated exact origins. Wildcards are rejected in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Used only to validate OAuth redirect targets. The React app is not included
# in this backend deliverable. Production origins must also be registered as
# Neon Auth trusted domains: `neon neon-auth domain add <origin>`.
FRONTEND_URL=http://localhost:5173
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:5173/auth/callback

REQUEST_TIMEOUT_SECONDS=90
MAX_REQUEST_BODY_BYTES=1048576
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------- database
# PRODUCTION: Neon (Lakebase PostgreSQL) connection string.
# Prefer the POOLED URL for the app (`DATABASE_URL` from `neon env pull`,
# hostname contains -pooler). Use DATABASE_URL_UNPOOLED for schema migrations.
DATABASE_URL=postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require

# Offline local development/tests only. SQLite must never be used in production:
# DATABASE_URL=sqlite:///./smart_travel_dev.db

# PostgreSQL schema changes are applied manually with backend/neon/schema.sql
# using the direct (unpooled) connection string.
# SQLite auto-creates its local schema when this is true.
AUTO_CREATE_SCHEMA=false
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=10

# -------------------------------------------------------------- Neon Auth
# Managed Better Auth on the branch. `neon env pull` writes both values.
NEON_AUTH_BASE_URL=https://<auth-host>.neonauth.<region>.aws.neon.tech
NEON_AUTH_JWKS_URL=https://<auth-host>.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Expected JWT iss/aud. Leave blank: the backend derives it from the base URL's
# host origin (verified live: Better Auth signs iss/aud without the tenant path).
NEON_AUTH_ISSUER=
# Origin header sent on server-to-server calls. Localhost ports are
# pre-approved by Neon Auth; register production origins with
# `neon neon-auth domain add`. Defaults to FRONTEND_URL when unset.
NEON_AUTH_ORIGIN=http://localhost:5173
NEON_AUTH_TIMEOUT_SECONDS=10
NEON_AUTH_JWKS_CACHE_SECONDS=3600
JWT_LEEWAY_SECONDS=30

# Symmetric HS256 verification is ONLY for offline tests and local
# development. Leave blank otherwise; production rejects it and verifies
# EdDSA tokens through the branch JWKS.
AUTH_HS256_SECRET=

# -------------------------------------------------------- Neon AI Gateway
# Optional. When both are set, Gemini calls are routed through the branch AI
# Gateway (native Gemini dialect). Requires AI Gateway credits.
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=

# --------------------------------------------------- Neon Object Storage
# Branch-scoped, S3-compatible storage. `neon env pull` writes these.
NEON_STORAGE_BUCKET=assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# ------------------------------------------------- Neon Realtime/Functions
# Declared branch services wired for configuration and readiness reporting.
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
NEON_FUNCTION_HOST_SUFFIX=

# ------------------------------------------------------------------ Gemini
# Direct Google API key. Not needed when the AI Gateway variables above are set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_TEMPERATURE=0.35

# ------------------------------------------------------------- Google Maps
# Enable Places API (New), Geocoding API, and Routes API for this key.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_TIMEOUT_SECONDS=10
GOOGLE_MAPS_LANGUAGE=en

# --------------------------------------------------------------- OpenWeather
OPENWEATHER_API_KEY=
OPENWEATHER_TIMEOUT_SECONDS=10
WEATHER_CACHE_TTL_SECONDS=600

# ---------------------------------------------------------------- itinerary
MAX_TRIP_DAYS=30
MAX_TRAVELLERS=20
MAX_ACTIVITIES_PER_DAY=8
MAX_ROUTE_LEGS=16
# Optional JSON object overriding planning-estimate rates. These are never
# live prices. Example:
# BUDGET_RATES_JSON={"USD":{"food_per_person_per_day":50}}
BUDGET_RATES_JSON=
